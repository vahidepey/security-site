name:Deploy Vite site to GitHub Pages
on:
  push:
      branches:
         -master
  permissions:
    contents:red
    pages:write
    id-token:write
jobs:
  build:
   runs-on: ubuntu-latest
   steps:
     -name: checkout
     uses: actions/checkout@v4
     -name: setup Node
     uses: actions/setup-node@v4
     with:
       node-version: 20
       cache: npm
       
       -name: install dependencies
       run: npm ci
       
       -name: Build
      run: npm run build

      -name: setup Pages
      uses: actions/configure-pages@v5
     
      -name: Upload artifact
    uses: actions/upload-pages-artifact@v3
  with:
          path: ./dist
  deploy:
      environment:
         name: github-pages
         url: ${{ setup.deployment.outputs.page-url }}
         
      runs-on: ubuntu-latest
      needs: build
      
     steps:
         -name: deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
       
     
          
  
  
